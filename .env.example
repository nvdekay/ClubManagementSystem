# Copy to .env — MongoDB is required; fill every Auth value to enable sign-in
# Production (NODE_ENV=production, the Docker image) also requires every Auth and SMTP value.
NODE_ENV=development
PORT=3000
# Behind a reverse proxy (nginx, a PaaS router) set the hop count, e.g. 1, so rate limits see the real client IP.
# Leave empty (= false) when clients connect directly; trusting a proxy that is not there lets clients spoof X-Forwarded-For.
TRUST_PROXY=
# /docs (Swagger UI + openapi.json) is off when NODE_ENV=production; set true to serve it anyway.
API_DOCS=
# Built client folder (client/dist) for one-container deployment; the Docker image sets it.
# Leave empty in development: Vite serves the client on :5173.
CLIENT_DIST_DIR=
MONGO_URI=mongodb://127.0.0.1:27017/ucms
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
ALLOWED_DOMAIN=
BOOTSTRAP_ICPDP_EMAIL=
APP_BASE_URL=
CLIENT_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email (EXT-02). Leave all empty in development to log emails instead of sending (MAIL_TRANSPORT=log).
# Production requires smtp. Google: smtp.gmail.com, port 587, SMTP_SECURE=false, an App Password.
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
