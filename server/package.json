{
  "name": "server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "seed": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed.ts",
    "seed:demo": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed-demo.ts",
    "seed:dashboard": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed-dashboard.ts",
    "seed:annual-hints": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed-annual-hints.ts",
    "seed:sponsored-payments": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed-sponsored-payments.ts",
    "seed:defense:p2": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed-defense-p2.ts",
    "seed:defense:p3": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed-defense-p3.ts",
    "seed:defense:p4": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed-defense-p4.ts",
    "seed:defense:p5": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed-defense-p5.ts",
    "seed:periodic-reports": "node --env-file-if-exists=../.env --import tsx src/infra/db/seed-periodic-reports.ts",
    "db:init": "node --env-file-if-exists=../.env --import tsx src/infra/db/init.ts",
    "db:verify": "node --env-file-if-exists=../.env --import tsx src/infra/db/verify.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "mongoose": "^8.24.11",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^5.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.2"
  }
}
