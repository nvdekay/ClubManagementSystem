@startuml D1_ClubLifecycle
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

title D1 - Club Lifecycle & Governance (UC01-UC14)

actor "User" as USER
actor "Student" as STU
actor "Club Management Board" as CMB
actor "ICPDP Officer" as ICPDP

STU -up-|> USER
CMB -up-|> USER
ICPDP -up-|> USER

rectangle UCMS {
  usecase UC01 as "UC01
  Authenticate via Google OAuth
  and access the workspace by permission"
  usecase UC02 as "UC02
  Submit a club establishment application"
  usecase UC03 as "UC03
  Assess the club establishment application"
  usecase UC04 as "UC04
  Request additions/corrections to the application"
  usecase UC05 as "UC05
  Resubmit the application after revision"
  usecase UC06 as "UC06
  Approve/Reject club establishment"
  usecase UC07 as "UC07
  Configure the club operating profile"
  usecase UC08 as "UC08
  Configure the club organization structure"
  usecase UC09 as "UC09
  Nominate the club management board"
  usecase UC10 as "UC10
  Confirm the management board"
  usecase UC11 as "UC11
  Plan the leadership transition"
  usecase UC12 as "UC12
  Confirm the leadership transition"
  usecase UC13 as "UC13
  Request club activity suspension"
  usecase UC14 as "UC14
  Suspend/Reactivate/Dissolve a club"
}

actor "Google OAuth" as OAUTH <<external system>>

USER -- UC01
UC01 -- OAUTH

STU -- UC02
STU -- UC05

CMB -- UC07
CMB -- UC08
CMB -- UC09
CMB -- UC11
CMB -- UC13

ICPDP -- UC03
ICPDP -- UC04
ICPDP -- UC06
ICPDP -- UC10
ICPDP -- UC12
ICPDP -- UC14
@enduml
