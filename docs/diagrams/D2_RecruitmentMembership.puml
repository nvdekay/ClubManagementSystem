@startuml D2_RecruitmentMembership
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

title D2 - Recruitment & Membership (UC15-UC23)

actor "Student" as STU
actor "Club Management Board" as CMB

rectangle UCMS {
  usecase UC15 as "UC15
  Create and publish a recruitment campaign"
  usecase UC16 as "UC16
  Submit a club membership application"
  usecase UC17 as "UC17
  Screen membership applications"
  usecase UC18 as "UC18
  Record candidate evaluation"
  usecase UC19 as "UC19
  Decide on a membership application"
  usecase UC20 as "UC20
  Onboard accepted candidates"
  usecase UC21 as "UC21
  Manage member status"
  usecase UC22 as "UC22
  Assign positions inside the club"
  usecase UC23 as "UC23
  Leave a club / Remove a member"
}

STU -- UC16
STU -- UC23

CMB -- UC15
CMB -- UC17
CMB -- UC18
CMB -- UC19
CMB -- UC20
CMB -- UC21
CMB -- UC22
CMB -- UC23
@enduml
