@startuml v2_D3_RecruitmentMembership
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam ArrowFontSize 11
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor White
  BorderColor Black
}
' inner frame: invisible, only adds padding inside the system boundary
skinparam rectangle<<inner>> {
  BorderColor Transparent
  FontColor Transparent
}
hide <<inner>> stereotype

title D3 - Recruitment & Membership (UC16-UC24)

actor "Student" as STU
actor "Club Management Board" as CMB

rectangle "UCMS" {
  rectangle " " <<inner>> {
    usecase "UC06\nBrowse clubs\n(see D2)" as UC06
    usecase "UC16\nPublish recruitment campaign" as UC16
    usecase "UC17\nApply for membership" as UC17
    usecase "UC18\nScreen applications" as UC18
    usecase "UC19\nRecord candidate evaluation" as UC19
    usecase "UC20\nOnboard members" as UC20
    usecase "UC21\nManage membership status" as UC21
    usecase "UC22\nRequest to leave club" as UC22
    usecase "UC23\nAssign positions" as UC23
    usecase "UC24\nView member workspace" as UC24
  }
}

STU -- UC17
STU -- UC22
STU -- UC24

CMB -- UC16
CMB -- UC18
CMB -- UC19
CMB -- UC20
CMB -- UC21
CMB -- UC23

UC17 ..> UC06 : <<extend>>
UC19 .[norank].> UC18 : <<extend>>
UC22 .[norank].> UC24 : <<extend>>
@enduml
