@startuml v2_D7_PropertyBooking
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

title D7 - Property & Facility Booking (UC46-UC49)

actor "Club Management Board" as CMB
actor "ICPDP Officer" as ICPDP

rectangle UCMS {
  usecase UC46 as "UC46
  Manage the property catalogue"
  usecase UC47 as "UC47
  Submit a property booking request"
  usecase UC48 as "UC48
  Assess and decide the
  property booking request"
  usecase UC49 as "UC49
  Track and cancel/release
  a booked property"
  usecase UC25 as "UC25
  Submit an event proposal
  (see D4a)"
  usecase UC28 as "UC28
  Cancel or reschedule an event
  (see D4a)"
}

UC47 ..> UC25 : <<extend>>
UC49 ..> UC28 : <<extend>>

ICPDP -- UC46
ICPDP -- UC48

CMB -- UC47
CMB -- UC49

note bottom of UC46
  Added in v2: v1 UC51 picked "a property from the
  catalogue ICPDP maintains" while no use case
  maintained it.
end note

note bottom of UC49
  Phase 1, not Phase 2: BR35 releases a booking when
  its event is cancelled. Without this use case an
  approved booking locks a room forever.
end note
@enduml
