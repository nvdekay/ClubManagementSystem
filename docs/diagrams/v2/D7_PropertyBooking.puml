@startuml v2_D7_PropertyBooking
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam ArrowFontSize 11
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor White
  BorderColor Black
}
' inner frame: invisible, only adds padding inside the system boundary
skinparam rectangle<<inner>> {
  BorderColor Transparent
  FontColor Transparent
}
hide <<inner>> stereotype

title D7 - Property & Facility Booking (UC46-UC49)

actor "Club Management Board" as CMB
actor "ICPDP Officer" as ICPDP

rectangle "UCMS" {
  rectangle " " <<inner>> {
    usecase "UC46\nManage property catalogue" as UC46
    usecase "UC47\nRequest property booking" as UC47
    usecase "UC48\nDecide booking request" as UC48
    usecase "UC49\nRelease booking" as UC49
    usecase "UC25\nSubmit event proposal\n(see D4a)" as UC25
    usecase "UC28\nCancel / reschedule event\n(see D4a)" as UC28
    usecase "UC15\nSuspend / dissolve club\n(see D2)" as UC15
    usecase "UC42\nManage compliance case\n(see D6)" as UC42
  }
}

CMB -- UC47
CMB -- UC49

UC46 -- ICPDP
UC48 -- ICPDP

UC47 ..> UC25 : <<extend>>
UC49 ..> UC28 : <<extend>>
UC49 <.. UC15 : <<include>>
UC49 <.. UC42 : <<extend>>

' layout only: ICPDP's own use cases share the right column, so ICPDP lands beside them
UC47 -[hidden]- UC46
UC49 -[hidden]- UC48
@enduml
