@startuml v2_D0_SystemContext
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

title UCMS v2 - System Context / Module Overview

actor "Student" as STU
actor "Club Management Board" as CMB
actor "ICPDP Officer" as ICPDP

rectangle "University Club Management System (UCMS)" {
  package "M01 Identity, Access & Configuration" as M01
  package "M02 Club Lifecycle & Governance" as M02
  package "M03 Leadership & Term" as M03
  package "M04 Recruitment & Membership" as M04
  package "M05 Event & Activity" as M05
  package "M06 Registration & Attendance" as M06
  package "M07 Finance & Budget" as M07
  package "M08 Reporting & Compliance" as M08
  package "M09 Performance Evaluation" as M09
  package "M10 Workflow, Notification & Audit" as M10
  package "M11 Property & Facility Booking" as M11
  package "M12 Feedback & Complaint" as M12
}

actor "Google OAuth" as OAUTH <<external system>>
actor "Google SMTP Service" as SMTP <<external system>>

STU -- M01
STU -- M02
STU -- M04
STU -- M06
STU -- M12

CMB -- M01
CMB -- M02
CMB -- M03
CMB -- M04
CMB -- M05
CMB -- M06
CMB -- M07
CMB -- M08
CMB -- M11
CMB -- M12

ICPDP -- M01
ICPDP -- M02
ICPDP -- M03
ICPDP -- M05
ICPDP -- M07
ICPDP -- M08
ICPDP -- M09
ICPDP -- M11
ICPDP -- M12

M01 -- OAUTH
M10 -- SMTP

note bottom of SMTP
  Every notification with an Email channel (section 19)
  is delivered through this service. The individual
  use cases are not wired to it on the detail diagrams.
end note

note bottom of M10
  Cross-cutting module: approval tasks, notifications,
  the scheduler that drives time-based transitions, and
  the audit log. It owns no use case (v2 section 7), so
  it is not expanded into a detail diagram.
end note

note bottom of M02
  Student reaches M02 through UC06 (discover clubs)
  and UC07 (submit an establishment application).
end note
@enduml
