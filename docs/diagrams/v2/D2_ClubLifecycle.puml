@startuml v2_D2_ClubLifecycle
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam ArrowFontSize 11
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor White
  BorderColor Black
}
' inner frame: invisible, only adds padding inside the system boundary
skinparam rectangle<<inner>> {
  BorderColor Transparent
  FontColor Transparent
}
hide <<inner>> stereotype

title D2 - Club Lifecycle, Governance & Term (UC06-UC15)

actor "Student" as STU
actor "Club Management Board" as CMB
actor "ICPDP Officer" as ICPDP

rectangle "UCMS" {
  rectangle " " <<inner>> {
    usecase "UC06\nBrowse clubs" as UC06
    usecase "UC07\nSubmit club application" as UC07
    usecase "UC08\nDecide club application" as UC08
    usecase "UC09\nConfigure club profile" as UC09
    usecase "UC10\nNominate board" as UC10
    usecase "UC11\nConfirm board" as UC11
    usecase "UC12\nPlan leadership transition" as UC12
    usecase "UC13\nConfirm leadership transition" as UC13
    usecase "UC14\nRequest suspension" as UC14
    usecase "UC15\nSuspend / dissolve club" as UC15
    usecase "UC28\nCancel / reschedule event\n(see D4a)" as UC28
    usecase "UC49\nRelease booking\n(see D7)" as UC49
    usecase "UC42\nManage compliance case\n(see D6)" as UC42
  }
}

STU -- UC06
STU -- UC07

CMB -- UC09
CMB -- UC10
CMB -- UC12
CMB -- UC14

UC08 -- ICPDP
UC11 -- ICPDP
UC13 -- ICPDP
UC15 -- ICPDP

UC15 ..> UC28 : <<include>>
UC15 ..> UC49 : <<include>>
UC15 ..> UC42 : <<extend>>

' layout only: keep ICPDP in its own column to the right of the frame
UC28 -[hidden]- ICPDP
@enduml
