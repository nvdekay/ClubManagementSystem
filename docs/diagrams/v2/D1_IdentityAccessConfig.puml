@startuml v2_D1_IdentityAccessConfig
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

title D1 - Identity, Access & Configuration (UC01-UC05)

actor "User" as USER
actor "Student" as STU
actor "Club Management Board" as CMB
actor "ICPDP Officer" as ICPDP

STU -up-|> USER
CMB -up-|> USER
ICPDP -up-|> USER

rectangle UCMS {
  usecase UC01 as "UC01
  Authenticate via Google OAuth
  and enter the role workspace"
  usecase UC02 as "UC02
  Open my role dashboard"
  usecase UC03 as "UC03
  Manage accounts and role assignments"
  usecase UC04 as "UC04
  Configure institutional policy and deadlines"
  usecase UC05 as "UC05 [Phase 2]
  Configure the approval routing rules"
}

actor "Google OAuth" as OAUTH <<external system>>

USER -- UC01
USER -- UC02
UC01 -- OAUTH

ICPDP -- UC03
ICPDP -- UC04
ICPDP -- UC05

note bottom of UC02
  One use case, three role-specific contents
  (v2 section 6). Every other use case is opened
  from here; those 50+ associations are not drawn.
end note

note bottom of UC04
  Phase 1 exposes only the values listed in v2 UC04
  (BR42). Every other rule marked "configurable"
  ships as a constant in one policy document.
end note
@enduml
