@startuml v2_D4b_ParticipationPostEvent
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

title D4b - Registration, Attendance & Event Accountability (UC29-UC34)

actor "Student" as STU
actor "Club Management Board" as CMB
actor "ICPDP Officer" as ICPDP

rectangle UCMS {
  usecase UC29 as "UC29
  Register for an event"
  usecase UC30 as "UC30 [Phase 2]
  Manage capacity and the waitlist"
  usecase UC31 as "UC31
  Check in to an event"
  usecase UC32 as "UC32
  Finalize event attendance"
  usecase UC33 as "UC33
  Submit the post-event report"
  usecase UC34 as "UC34
  Assess and close the event report"
  usecase UC50 as "UC50 [Phase 2]
  Submit post-event feedback
  (see D8)"
}

UC30 ..> UC29 : <<extend>>

STU -- UC29
STU -- UC31
STU -- UC50

CMB -- UC30
CMB -- UC32
CMB -- UC33
CMB ..> UC31 : supporting

ICPDP -- UC34

note bottom of UC31
  Student is the primary actor (self check-in).
  A CMB member with the permission may check a
  participant in manually - an alternative flow,
  recorded with who did it (BR18).
end note

note bottom of UC50
  The feedback window opens at check-in (BR36, changed
  in v2), not after UC32 finalization. A club that
  finalizes late no longer kills its own response rate.
end note
@enduml
