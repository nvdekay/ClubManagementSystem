@startuml v2_D4a_EventApproval
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam ArrowFontSize 11
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor White
  BorderColor Black
}
' inner frame: invisible, only adds padding inside the system boundary
skinparam rectangle<<inner>> {
  BorderColor Transparent
  FontColor Transparent
}
hide <<inner>> stereotype

title D4a - Event Proposal & Approval (UC25-UC28)

actor "Club Management Board" as CMB
actor "ICPDP Officer" as ICPDP

rectangle "UCMS" {
  rectangle " " <<inner>> {
    usecase "UC25\nSubmit event proposal" as UC25
    usecase "UC26\nDecide event proposal" as UC26
    usecase "UC27\nPublish event" as UC27
    usecase "UC28\nCancel / reschedule event" as UC28
    usecase "UC47\nRequest property booking\n(see D7)" as UC47
    usecase "UC49\nRelease booking\n(see D7)" as UC49
    usecase "UC15\nSuspend / dissolve club\n(see D2)" as UC15
  }
}

CMB -- UC25
CMB -- UC27
CMB -- UC28

UC26 -- ICPDP

UC25 <.. UC47 : <<extend>>
UC28 <.. UC49 : <<extend>>
UC28 <.. UC15 : <<include>>

' layout only: keep ICPDP in its own column to the right of the frame
UC47 -[hidden]- ICPDP
@enduml
