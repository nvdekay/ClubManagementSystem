@startuml v2_D8_FeedbackComplaint
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam ArrowFontSize 11
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor White
  BorderColor Black
}
' inner frame: invisible, only adds padding inside the system boundary
skinparam rectangle<<inner>> {
  BorderColor Transparent
  FontColor Transparent
}
hide <<inner>> stereotype

title D8 - Feedback & Complaint (UC50-UC54)

actor "Student" as STU
actor "Club Management Board" as CMB
actor "ICPDP Officer" as ICPDP

rectangle "UCMS" {
  rectangle " " <<inner>> {
    usecase "UC50\nSubmit event feedback" as UC50
    usecase "UC51\nReview event feedback" as UC51
    usecase "UC52\nSubmit complaint" as UC52
    usecase "UC53\nTriage complaint" as UC53
    usecase "UC54\nRespond to complaint" as UC54
    usecase "UC33\nSubmit event report\n(see D4b)" as UC33
    usecase "UC42\nManage compliance case\n(see D6)" as UC42
  }
}

STU -- UC50
STU -- UC52

CMB -- UC51
CMB -- UC54

UC53 -- ICPDP

UC51 ..> UC33 : <<extend>>
UC42 ..> UC53 : <<extend>>
@enduml
