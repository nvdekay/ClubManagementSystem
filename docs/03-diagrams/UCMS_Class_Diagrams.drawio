        <mxCell id="n1" value="&lt;b&gt;Entity operations -&amp;gt; source&lt;/b&gt;&lt;br&gt;ClubEvent.changeCapacity(): mongo act(&quot;capacity&quot;) - state Upcoming (or legacy PUBLIC), startAt &amp;gt; now, registration window open&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(registrationOpenAt &amp;lt;= now &amp;lt; registrationCloseAt), else 409 &quot;registration is not open&quot;; capacity &amp;lt; confirmedRegistrationCount -&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;409 &quot;capacity cannot be below confirmed registrations&quot; {registrationIds}; sets capacity, then promoteEventWaitlist(); audit EVENT_CAPACITY&lt;br&gt;ClubEvent.hasFreeSeat(): promoteEventWaitlist() loop guard - waitlistEnabled and confirmedRegistrationCount &amp;lt; capacity&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(with registrationId: no seat -&amp;gt; 409 &quot;there is no available seat in the registration window&quot;)&lt;br&gt;EventRegistration.promote(): promoteEventWaitlist() - head of the waitlist (lowest waitlistPosition) -&amp;gt; Confirmed, promotedAt set,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;waitlistPosition cleared, event confirmedRegistrationCount + 1; audit EVENT_REGISTRATION_PROMOTED; EVENT_REGISTRATION_PROMOTED&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;in-app notice; MEMBERS_ONLY head without Active membership -&amp;gt; Cancelled (audit EVENT_WAITLIST_INELIGIBLE). act(&quot;promote&quot;) audits EVENT_PROMOTE&lt;br&gt;EventParticipant.isWaitlistHead(): requested registration must be the head, else 409 &quot;only the first waitlisted registration can be promoted&quot;&lt;br&gt;ClubEventAction.requiredPermission(): domain eventActionPermission() -&amp;gt; club.event.manage (participants list: club.attendance.manage);&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;mongo act() re-checks with assertEventWriteAccess() inside the transaction&lt;br&gt;Legacy PUBLIC (internal MEMBERS_ONLY) events pass the write guard only: act() commits, then readClubEvent() (audienceScope&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;PUBLIC&quot; filter) finds nothing and the response is 404 &quot;event not found&quot;" style="shape=note;whiteSpace=nowrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFF4;strokeColor=#B0BEC5;fontSize=10;fontFamily=Arial;" parent="1" vertex="1">
          <mxGeometry x="0" y="1240" width="817" height="202" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=10;fontFamily=Arial;strokeColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;exitX=0.3000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bR" target="uC">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=10;fontFamily=Arial;strokeColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;exitX=0.2000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1804;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="uC" target="dCR">
