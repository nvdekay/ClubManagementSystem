                <mxCell id="g04_help" parent="p1794" style="swimlane;fontStyle=0;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#ECEFF1;swimlaneFillColor=#ECEFF1;strokeColor=#37474F;fontSize=11;fontFamily=Arial;spacingTop=2;" value="&lt;i&gt;«infra»&lt;/i&gt;&lt;br&gt;&lt;b&gt;event-defense-helpers&lt;/b&gt;" vertex="1">
