                <mxCell id="c147" parent="k_ucmsModels_c144" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;whiteSpace=nowrap;overflow=visible;rotatable=0;fontSize=11;fontFamily=Arial;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
