<!-- Server -->
<mxCell id="server" value="&lt;b&gt;Server — UCMS API&lt;/b&gt;&lt;br&gt;Node.js · Express 5 · Mongoose · TypeScript (one process)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;verticalAlign=top;align=center;fillColor=#fafafa;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="650" height="720" as="geometry"/></mxCell>
<mxCell id="s_if" value="&lt;b&gt;interface/http&lt;/b&gt;&lt;br&gt;REST routes /api/v1 · auth routes (OAuth callback)&lt;br&gt;RBAC middleware · input validation (zod)&lt;br&gt;Error handler · OpenAPI /docs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="990" y="180" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="s_uc" value="&lt;b&gt;usecase&lt;/b&gt;&lt;br&gt;One function per business flow&lt;br&gt;Business rules · scope checks&lt;br&gt;Approval, notification enqueue, audit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="990" y="350" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="s_dom" value="&lt;b&gt;domain&lt;/b&gt;&lt;br&gt;Entities · state machines&lt;br&gt;DomainError · repository / service ports" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="990" y="520" width="340" height="90" as="geometry"/></mxCell>
