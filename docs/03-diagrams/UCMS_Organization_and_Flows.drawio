<mxfile host="drawio"><diagram id="org" name="Organization structure"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Organization structure" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="30" as="geometry"/></mxCell><mxCell id="uni" value="&lt;b&gt;University&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;owner of the club programme&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="280" height="60" as="geometry"/></mxCell><mxCell id="icp" value="&lt;b&gt;ICPDP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;single approval authority (BR31)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="210" width="280" height="60" as="geometry"/></mxCell><mxCell id="adv" value="&lt;b&gt;Advisory units — outside UCMS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Finance, Facilities, Security, faculty advisers&lt;br&gt;opinion recorded in the ICPDP review note&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="210" width="300" height="76" as="geometry"/></mxCell><mxCell id="club" value="&lt;b&gt;Club (one active term)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;ClubTerm; lifecycle UC07–UC15&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="210" width="280" height="60" as="geometry"/></mxCell><mxCell id="stu" value="&lt;b&gt;Students&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;actor Student&lt;br&gt;applicants, attendees, founders&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="210" width="260" height="76" as="geometry"/></mxCell><mxCell id="head" value="&lt;b&gt;ICPDP Head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;role ICPDP_HEAD&lt;br&gt;second approval level (UC05, BR16)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="250" height="76" as="geometry"/></mxCell><mxCell id="off" value="&lt;b&gt;ICPDP Officer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;role ICPDP_OFFICER&lt;br&gt;review, decide, disburse, reconcile&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="350" width="250" height="76" as="geometry"/></mxCell><mxCell id="pres" value="&lt;b&gt;President&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;actor Club Leader&lt;br&gt;seat confirmed by ICPDP (UC11 / UC13)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="350" width="280" height="76" as="geometry"/></mxCell><mxCell id="exe" value="&lt;b&gt;Executive board&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Vice-president, heads of department&lt;br&gt;holders confirmed by ICPDP (UC10 / UC11 / UC13)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="470" width="280" height="76" as="geometry"/></mxCel