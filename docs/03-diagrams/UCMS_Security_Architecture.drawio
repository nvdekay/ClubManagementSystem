<mxfile host="drawio"><diagram id="sec" name="Security architecture"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="UCMS security architecture - defence in depth for every /api/v1 request" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1240" height="36" as="geometry"/></mxCell><mxCell id="L1" value="&lt;b&gt;1. Browser (React SPA, same origin)&lt;/b&gt;&lt;br&gt;Cookie &lt;i&gt;ucms_session&lt;/i&gt;: httpOnly, SameSite=Lax, Secure in production.&lt;br&gt;Mutations send header &lt;i&gt;X-CSRF-Token&lt;/i&gt; (from GET /auth/me)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#455A64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="700" height="92" as="geometry"/></mxCell><mxCell id="L2" value="&lt;b&gt;2. Transport and response headers&lt;/b&gt; (server.ts)&lt;br&gt;HTTPS at the hosting proxy; nosniff, X-Frame-Options DENY,&lt;br&gt;Referrer-Policy no-referrer, x-powered-by off; no CORS enabled." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#455A64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="182" width="700" height="80" as="geometry"/></mxCell><mxCell id="v1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L3" value="&lt;b&gt;3. Parse and route&lt;/b&gt;&lt;br&gt;requestLogger; express.json() (100 kB); uploads raw &amp;lt;= 10 MB.&lt;br&gt;Public routes (/health, discovery, /auth/login, /auth/callback, /auth/me) skip authGuard." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#455A64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="292" width="700" height="80" as="geometry"/></mxCell><mxCell id="P3" value="413 / 400" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="315.0" width="170" height="34" as="geometry"/></mxCell><mxCell id="eP3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C62828;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L3" target="P3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L4" value="&lt;b&gt;4. Authentication - authGuard&lt;/b&gt; (auth-routes.ts)&lt;br&gt;Verify HMAC-SHA256 of the session token; look up the session by SHA-256(token),&lt;br&gt;not revoked, not expired; reload user; reject Locked;&lt;br&gt;compare X-CSRF-Token in constant time on every mutating route." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#455A64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="402" width="700" height="92" as="geometry"/></mxCell><mxCell id="P4" value="401 / 423 / 403" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="431.0" width="170" height="34" as="geometry"/></mxCell><mxCell id="eP4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C62828;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L4" target="P4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L5" value="&lt;b&gt;5. Input validation&lt;/b&gt; (route)&lt;br&gt;zod schemas (.strict(), lengths, enums, 24-hex ObjectId); domain factories." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#455A64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="524" width="700" height="72" as="geometry"/></mxCell><mxCell id="P5" value="400" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="543.0" width="170" height="34" as="geometry"/></mxCell><mxCell id="eP5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C62828;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L5" target="P5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L6" value="&lt;b&gt;6. Authorization&lt;/b&gt; (use case) - one of:&lt;br&gt;&amp;#8226; ICPDP operations: system role ICPDP_OFFICER (officer())&lt;br&gt;&amp;#8226; Club operations: assertClubAccess - Active membership in this club,&lt;br&gt;&amp;#160;&amp;#160;Active current term, confirmed leader / board seat effective now&lt;br&gt;&amp;#8226; Personal records: findOwned(id, actorId)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#455A64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="626" width="700" height="122" as="geometry"/></mxCell><mxCell id="P6" value="403 / 404" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="670.0" width="170" height="34" as="geometry"/></mxCell><mxCell id="eP6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C62828;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L6" target="P6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L5" target="L6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L7" value="&lt;b&gt;7. Business rules, transaction and audit&lt;/b&gt; (domain + infra/db)&lt;br&gt;Domain rules; mongoose.connection.transaction; state-guarded updates;&lt;br&gt;access re-checked where needed; auditLogs + notifications in the same transaction." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#455A64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="778" width="700" height="92" as="geometry"/></mxCell><mxCell id="P7" value="400 / 409" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="807.0" width="170" height="34" as="geometry"/></mxCell><mxCell id="eP7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C62828;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L7" target="P7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L6" target="L7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L8" value="&lt;b&gt;8. Error handling&lt;/b&gt; - errorHandler (middleware.ts)&lt;br&gt;DomainError kind to status; unexpected errors give a generic 500 (details only in server log)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="900" width="700" height="72" as="geometry"/></mxCell><mxCell id="P8" value="500" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="919.0" width="170" height="34" as="geometry"/></mxCell><mxCell id="eP8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C62828;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L8" target="P8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L7" target="L8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="G" value="&lt;b&gt;Google OIDC&lt;/b&gt;&lt;br&gt;state, nonce, PKCE S256;&lt;br&gt;ID token RS256 via JWKS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;align=center;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1090" y="292" width="190" height="80" as="geometry"/></mxCell><mxCell id="eG" value="login flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L3" target="G"><mxGeometry relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="DB" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;authSessions&lt;br&gt;(token / CSRF hashes, TTL)&lt;br&gt;&lt;br&gt;users, roles, clubs,&lt;br&gt;memberships, terms ...&lt;br&gt;&lt;br&gt;auditLogs&lt;br&gt;notifications" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=14;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1090" y="402" width="190" height="468" as="geometry"/></mxCell><mxCell id="eDB4" value="session lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.09829059829059829;entryDx=0;entryDy=0;" edge="1" parent="1" source="L4" target="DB"><mxGeometry relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="eDB6" value="role / snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6089743589743589;entryDx=0;entryDy=0;" edge="1" parent="1" source="L6" target="DB"><mxGeometry relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="eDB7" value="transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#37474F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9017094017094017;entryDx=0;entryDy=0;" edge="1" parent="1" source="L7" target="DB"><mxGeometry relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>